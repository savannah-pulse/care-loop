<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    HIS simulator (WS7). Shared build rules (target framework, nullable, documentation
    enforcement) come from the repository-root Directory.Build.props.
    This project must never reference anything under src/api/: it builds and parses FHIR itself.
  -->
  <PropertyGroup>
    <RootNamespace>HisSimulator</RootNamespace>
    <AssemblyName>HisSimulator</AssemblyName>
    <!-- The React ClientApp is built by Yarn/Vite, not by MSBuild. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

</Project>
