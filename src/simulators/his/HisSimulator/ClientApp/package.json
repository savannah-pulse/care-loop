{
  "name": "his-simulator-client",
  "version": "0.0.0",
  "private": true,
  "description": "ClientApp for the CareLoop HIS simulator (WS7). Synthetic data only.",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn lint && yarn typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "i18next": "25.10.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "16.6.6",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "61.7.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "resolutions": {
    "rolldown": "1.2.16",
    "@rolldown/pluginutils": "1.0.1",
    "@typescript-eslint/types": "8.72.1",
    "@typescript-eslint/tsconfig-utils": "8.72.1",
    "electron-to-chromium": "1.5.478"
  }
}
