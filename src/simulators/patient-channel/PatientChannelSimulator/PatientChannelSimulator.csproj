<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Patient-channel simulator (WS8). TargetFramework, Nullable, ImplicitUsings, documentation
    generation and warnings-as-errors come from the repository-root Directory.Build.props.
    This project deliberately has NO project references: it shares no code with src/api/ or the
    HIS simulator and builds and parses FHIR itself.
  -->
  <PropertyGroup>
    <RootNamespace>PatientChannelSimulator</RootNamespace>
    <AssemblyName>PatientChannelSimulator</AssemblyName>
    <!-- The React ClientApp is built by Yarn/Vite, not MSBuild; keep it out of the default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="6.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

</Project>
