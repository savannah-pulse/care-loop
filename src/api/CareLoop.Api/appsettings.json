{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CareLoop": "Host=localhost;Port=5432;Database=careloop;Username=careloop;Password=change-me-local-only"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Pathways": {
    "Directory": "Infrastructure/Pathways"
  },
  "ExternalSystems": {
    "Systems": { }
  },
  "Notifications": {
    "EnabledProviders": [ "Simulator" ],
    "PerEventOverrides": { },
    "Simulator": {
      "PatientChannelBaseUrl": "",
      "StaffInboxBaseUrl": "",
      "InboundSecret": ""
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "MaxAttempts": 10
  },
  "DeadlineWorker": {
    "Enabled": false,
    "Interval": "00:00:30"
  },
  "Ai": {
    "Provider": "NoOp",
    "AzureOpenAi": {
      "Endpoint": "",
      "Deployment": "",
      "ApiKey": ""
    }
  }
}
