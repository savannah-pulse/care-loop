# CareLoop local environment. Copy to .env and adjust.
# This file is a template for local development against the simulators. Never commit a real
# credential or a live endpoint address; production values belong in a secret store.

# --- Database (local container only) ---
POSTGRES_DB=careloop
POSTGRES_USER=careloop
POSTGRES_PASSWORD=change-me-local-only

# --- Host ports ---
API_PORT=8080
WEB_PORT=4173
AI_WORKFLOW_PORT=8081
HIS_SIMULATOR_PORT=5081
PATIENT_CHANNEL_SIMULATOR_PORT=5082
POSTGRES_PORT=5432

# --- Messaging simulator callback ---
# Shared with the messaging simulator (the messaging-simulator service), which signs the
# delivery reports and replies it posts to /notifications/inbound/sms and /notifications/inbound/email.
# The API refuses every inbound message while this is empty.
SIMULATOR_INBOUND_SECRET=change-me-local-only

# --- How simulated patients are reached ---
# sms or email. CareLoop reaches people by text message and email only; there is no patient app.
PATIENT_CONTACT_CHANNEL=sms

# --- AI handoff summary (optional; NoOp keeps AI off) ---
AI_PROVIDER=NoOp
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30
# For AI_PROVIDER=FoundryDirect: https://<resource>.services.ai.azure.com/api/projects/<project>
AI_FOUNDRY_PROJECT_ENDPOINT=

# --- Foundry agents on the dashboard (optional; off by default) ---
# The role briefing, the impact summary and the patient message preview, on the route AI_PROVIDER chooses. With
# FoundryDirect the API calls them with its own Entra identity (DefaultAzureCredential: a managed identity in Azure),
# which needs the Foundry User role (formerly Azure AI User) on the Foundry project; with AiWorkflow the Python service
# calls them. There is no key. Never put an access token here: Ai__Agents__AccessToken is for `dotnet run` only.
AI_AGENTS_ENABLED=false
# Each agent pinned as name:version, as in src/ai_agents/*/run_agent.py.
AI_AGENTS_ROLE_BRIEFING=role-briefing:2
AI_AGENTS_IMPACT_SUMMARY=impact-summary:4
AI_AGENTS_PATIENT_NOTIFICATION=patient-notification:2
