# CareLoop local environment. Copy to .env and adjust.
# This file is a template for local development against the simulators. Never commit a real
# credential or a live endpoint address; production values belong in a secret store.

# --- Database (local container only) ---
POSTGRES_DB=careloop
POSTGRES_USER=careloop
POSTGRES_PASSWORD=change-me-local-only

# --- Host ports ---
API_PORT=8080
WEB_PORT=4173
AI_WORKFLOW_PORT=8081
HIS_SIMULATOR_PORT=5081
PATIENT_CHANNEL_SIMULATOR_PORT=5082
POSTGRES_PORT=5432

# --- Simulator notification callback ---
# Shared with the patient-channel simulator, which signs what it posts to /notifications/inbound/simulator.
# The API refuses every inbound message while this is empty.
SIMULATOR_INBOUND_SECRET=change-me-local-only

# --- AI handoff summary (optional; NoOp keeps AI off) ---
AI_PROVIDER=NoOp
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
