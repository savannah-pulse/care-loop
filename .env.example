# CareLoop local environment. Copy to .env and adjust.
# This file is a template for local development against the simulators. Never commit a real
# credential or a live endpoint address; production values belong in a secret store.

# --- Database (local container only) ---
POSTGRES_DB=careloop
POSTGRES_USER=careloop
POSTGRES_PASSWORD=change-me-local-only

# --- Host ports ---
API_PORT=8080
WEB_PORT=4173
HIS_SIMULATOR_PORT=5081
PATIENT_CHANNEL_SIMULATOR_PORT=5082
POSTGRES_PORT=5432

# --- Messaging simulator callback ---
# Shared with the messaging simulator (the messaging-simulator service), which signs the
# delivery reports and replies it posts to /notifications/inbound/sms and /notifications/inbound/email.
# The API refuses every inbound message while this is empty.
SIMULATOR_INBOUND_SECRET=change-me-local-only

# --- How simulated patients are reached ---
# sms or email. CareLoop reaches people by text message and email only; there is no patient app.
PATIENT_CONTACT_CHANNEL=sms

# --- AI (optional; NoOp keeps AI off) ---
# Foundry: the API asks the agents in a Microsoft Foundry project (role-briefing, impact-summary,
# patient-notification) with its own Entra identity. No key is ever set here.
AI_PROVIDER=NoOp
AZURE_AI_PROJECT_ENDPOINT=
AI_TIMEOUT_SECONDS=30
# Hours a briefing or impact summary is reused while its data is unchanged; 0 switches reuse off.
AI_CACHE_HOURS=6
