# CareLoop local environment. Copy to .env and adjust.
# This file is a template for local development against the simulators. Never commit a real
# credential or a live endpoint address; production values belong in a secret store.

# --- Database (local container only) ---
POSTGRES_DB=careloop
POSTGRES_USER=careloop
POSTGRES_PASSWORD=change-me-local-only

# --- Host ports ---
API_PORT=8080
WEB_PORT=4173
AI_WORKFLOW_PORT=8081
HIS_SIMULATOR_PORT=5081
PATIENT_CHANNEL_SIMULATOR_PORT=5082
POSTGRES_PORT=5432

# --- SMS and email simulator callback ---
# Shared with the SMS and email simulator (the patient-channel-simulator service), which signs the
# delivery reports and replies it posts to /notifications/inbound/sms and /notifications/inbound/email.
# The API refuses every inbound message while this is empty.
SIMULATOR_INBOUND_SECRET=change-me-local-only

# --- How simulated patients are reached ---
# sms or email. CareLoop reaches people by text message and email only; there is no patient app.
PATIENT_CONTACT_CHANNEL=sms

# --- AI handoff summary (optional; NoOp keeps AI off) ---
AI_PROVIDER=NoOp
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# --- Foundry agents on the dashboard (optional; off by default) ---
# The role briefing, the impact summary and the patient message preview. The API calls them with its own Entra
# identity (DefaultAzureCredential: a managed identity in Azure), which needs the Azure AI User role on the Foundry
# project. There is no key. Never put an access token here: Ai__Agents__AccessToken is for `dotnet run` only.
AI_AGENTS_ENABLED=false
# https://<resource>.services.ai.azure.com/api/projects/<project>
AI_AGENTS_PROJECT_ENDPOINT=
AI_AGENTS_ROLE_BRIEFING=role-briefing
AI_AGENTS_IMPACT_SUMMARY=impact-summary
AI_AGENTS_PATIENT_NOTIFICATION=patient-notification
AI_AGENTS_TIMEOUT_SECONDS=30
